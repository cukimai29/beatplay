<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher background: near-black, matching the emblem tile fill so
     the full-bleed foreground has no visible seam on any launcher mask. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="135"
        android:startColor="#1F2033"
        android:centerColor="#222338"
        android:endColor="#252639"
        android:type="linear" />
</shape>
